{
  "name": "@absolutejs/email",
  "version": "0.2.1",
  "description": "Provider-neutral email sync adapters for AbsoluteJS: Gmail, Microsoft Graph, and IMAP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/email.git"
  },
  "homepage": "https://github.com/absolutejs/email",
  "bugs": {
    "url": "https://github.com/absolutejs/email/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "type": "module",
  "absolutejs": {
    "manifestContract": 2
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/index.js",
    "dist/manifest.js",
    "dist/manifest.json",
    "dist/verification.js",
    "dist/verification-imap.js",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verification": {
      "types": "./dist/verification.d.ts",
      "import": "./dist/verification.js"
    },
    "./verification/imap": {
      "types": "./dist/verification-imap.d.ts",
      "import": "./dist/verification-imap.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/manifest.ts src/verification.ts src/verification-imap.ts --outdir dist --root src --target=bun --external imapflow && tsc --emitDeclarationOnly --project tsconfig.json && absolute-manifest emit",
    "check:package": "bun run typecheck && bun run test && bun run build && bun run verify-package",
    "format": "prettier --write \"./**/*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"./**/*.{js,ts,json,md}\"",
    "release": "bun run check:package && npm publish --access public",
    "test": "bun test",
    "typecheck": "bun run tsc --noEmit",
    "verify-package": "absolute-manifest verify-package"
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.9.0",
    "@sinclair/typebox": "^0.34.0",
    "imapflow": "^1.4.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "^3.9.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
